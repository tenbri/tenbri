# The test vectors are exact bytes: LF line ends, HEAD with no final line feed. Git must never
# convert them, or a checkout with core.autocrlf (Windows) breaks the byte-for-byte rule.
spec/vectors/** -text

# tenbrid's contract and the code generated from it are compared byte for byte
# (crates/tenbri-server/tests/contract.rs): LF everywhere.
contract/** text eol=lf
crates/tenbri-server/src/proto.rs text eol=lf
