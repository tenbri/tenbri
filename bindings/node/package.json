{
  "name": "tenbri",
  "version": "0.0.0",
  "description": "Audit trail for AI agents: every decision signed, chained and provable.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tenbri/tenbri.git",
    "directory": "bindings/node"
  },
  "main": "tenbri.js",
  "types": "tenbri.d.ts",
  "files": [
    "tenbri.js",
    "tenbri.d.ts",
    "index.js",
    "index.d.ts"
  ],
  "engines": {
    "node": ">= 20"
  },
  "napi": {
    "binaryName": "tenbri",
    "packageName": "@tenbri/node",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release",
    "test": "tsc -p . && node --test __test__/*.test.mts"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
