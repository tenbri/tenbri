# The Rust core (bindings/python/src/lib.rs). Drafts, entries, reports and query results are JSON
# strings; the tenbri package turns them into dicts and dataclasses.
from typing import Any, Awaitable

__version__: str

def new_id() -> str: ...
def _resolve(fut: Any, ok: bool, value: Any) -> None: ...

class Stream:
    @staticmethod
    def open(
        location: str, keys: str | None = None, key: str | None = None, create: bool = False
    ) -> Stream: ...
    @staticmethod
    def open_async(
        location: str, keys: str | None = None, key: str | None = None, create: bool = False
    ) -> Awaitable[Stream]: ...
    @property
    def id(self) -> str: ...
    @property
    def fingerprint(self) -> str | None: ...
    @property
    def writable(self) -> bool: ...
    def append(self, draft: str) -> str: ...
    def append_async(self, draft: str) -> Awaitable[str]: ...
    def intent(self, draft: str) -> str: ...
    def intent_async(self, draft: str) -> Awaitable[str]: ...
    def outcome(self, intent: str, status: str, draft: str) -> str: ...
    def outcome_async(self, intent: str, status: str, draft: str) -> Awaitable[str]: ...
    def verify(self, key: str | None = None) -> str: ...
    def verify_async(self, key: str | None = None) -> Awaitable[str]: ...
    def query(self, filter: str) -> str: ...
    def query_async(self, filter: str) -> Awaitable[str]: ...
    def flush(self) -> None: ...
    def flush_async(self) -> Awaitable[None]: ...
    def close(self) -> None: ...
    def close_async(self) -> Awaitable[None]: ...
